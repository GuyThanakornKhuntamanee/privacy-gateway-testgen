    "language": {"th": 0.45, "en": 0.25, "mixed": 0.30},
    "length": {"short": 0.30, "medium": 0.40, "long": 0.30},
    "difficulty": {"1": 0.12, "2": 0.20, "3": 0.25, "4": 0.25, "5": 0.18},
    "negative_ratio": 0.20,
