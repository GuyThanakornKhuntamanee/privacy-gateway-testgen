้และไม่มีการร้องขอคืนเงินในรอบนี้\n\nรายงานฉบับนี้จัดทำขึ้นเพื่อการทดสอบภายในเท่านั้น ข้อมูลทั้งหมดเป็นข้อมูลสังเคราะห์\nกรุณาตรวจสอบความถูกต้องของข้อมูลก่อนนำไปใช้ในขั้นตอนถัดไป\nระบบสำรองข้อมูลทำงานตามกำหนดและไม่พบข้อผิดพลาดในช่วงเวลาที่ตรวจสอบ\nข้อมูลส่วนนี้เป็นบริบทประกอบการทดสอบ ไม่มีผลต่อการตัดสินใจของระบบ\nทีมปฏิบัติการได้ตรวจสอบบันทึกการเปลี่ยนแปลงและยืนยันว่าไม่มีผลกระทบต่อบริการ\nผลการทดสอบก่อนหน้าอยู่ในเกณฑ์ปกติ และไม่มีการเปลี่ยนแปลงการตั้งค่าที่สำคัญ\nคำขอ\n\nช่วยสรุปรายงานนี้สำหรับผู้บริหาร โดยระบุข้อมูลที่ต้องปิดก่อนส่งออกภายนอก และแยกประเภทข้อมูลส่วนบุคคลกับข้อมูลการชำระเงินให้ชัดเจน\n", "prompt_length": 1108, "prompt_length_class": "long", "prompt_style": "mixed_domain", "prompt_styles": ["long", "mixed_domain"], "rationale": "Enterprise report combining customer PII and payment records. Scenario: Sensitive content may not leave the local environment.", "routing_expected": "local", "schema_version": "1.0", "seed": 7, "split": "test", "structure": "report", "structured": false, "tags": ["card_expiry_date", "difficulty:4", "email_address", "lang:th", "multi-domain", "payment", "payment_card_number", "payment_transaction_reference", "pii", "report", "split:test", "thai_address", "thai_name", "thai_national_id", "thai_phone"], "template_family": "long_enterprise_report", "template_id": "long_enterprise_report", "test_category": "multi_domain", "test_id": "pgt-tst-00007", "test_objective": "cross_domain_policy", "token_restoration_expected": "not_applicable", "transformation_expected": [{"action": "LOCAL_ONLY", "entity_type": "card_expiry_date"}, {"action": "LOCAL_ONLY", "entity_type": "email_address"}, {"action": "LOCAL_ONLY", "entity_type": "payment_card_number"}, {"action": "LOCAL_ONLY", "entity_type": "payment_transaction_reference"}, {"action": "LOCAL_ONLY", "entity_type": "thai_address"}, {"action": "LOCAL_ONLY", "entity_type": "thai_name"}, {"action": "LOCAL_ONLY", "entity_type": "thai_national_id"}, {"action": "LOCAL_ONLY", "entity_type": "thai_p