{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "orders-api",
    "namespace": "kata-cloudworks-prod"
  },
  "spec": {
    "replicas": 3,
    "selector": {
      "matchLabels": {
        "app": "orders-api"
      }
    },
    "template": {
      "spec": {
        "containers": [
          {
            "name": "api",
            "image": "registry.kata-cloudworks.example/orders:1.4.2",
            "env": [
              {
                "name": "APP_ENV",
                "value": "production"
              },
              {
                "name": "DB_PASSWORD",
                "value": "Example-Fake-Passw0rd-1455!"
              },
              {
                "name": "API_KEY",
                "value": "sk_example_fake_040ba2303d9e9d0f1bb08c68"
              },
              {
                "name": "DB_HOST",
                "value": "db-analytics.kata-cloudworks.internal:5432"
              }
            ]
          }
        ]
      }
    }
  },
  "_language_note": "เอกสารตัวอย่างสังเคราะห์สำหรับทดสอบ privacy gateway เท่านั้น"
}
